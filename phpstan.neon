includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    # EquiFlow: Larastan Level 7. Analyse über `composer types:check` (512M Memory-Limit).
    # Ignore-Listen nur mit Begründung und Ticket ergänzen.
    level: 7
